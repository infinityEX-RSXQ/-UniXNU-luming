 #define PI3_UART
 
+/*
+ * Qualcomm GENI/QUPv3 UART console backend (project addition for the luming
+ * SM8735 port; see agents/xnu-geni/REPORT-GENI.md).  The backend is polled,
+ * TX-first and assumes bootloader-initialized clocks/pins/baud; it registers
+ * only when the ADT has an /arm-io/uart node.  Apple's other serial backends
+ * are unchanged.
+ */
+#define QCOM_GENI_UART 1
+
 #define PI3_BREAK                               asm volatile("brk #0");
 
 #define BCM2837_GPFSEL0_V               (pi3_gpio_base_vaddr + 0x0)
