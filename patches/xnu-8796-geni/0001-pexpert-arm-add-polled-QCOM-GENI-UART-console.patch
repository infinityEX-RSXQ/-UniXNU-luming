diff --git a/pexpert/pexpert/arm/qcom_geni_uart.h b/pexpert/pexpert/arm/qcom_geni_uart.h
new file mode 100644
index 0000000000000000000000000000000000000000..02122e7c0c5bd16052fcc0c08ee9f5d8f401550a
--- /dev/null
+++ b/pexpert/pexpert/arm/qcom_geni_uart.h
@@ -0,0 +1,68 @@
+/*
+ * Qualcomm GENI/QUPv3 serial-engine (UART) register offsets used by the polled
+ * early-console backend in pexpert/arm/pe_serial.c.
+ *
+ * Project addition for the luming (Xiaomi Civi 5 Pro, SM8735) iOS 16 port.
+ * The GENI serial-engine layout matches the layout already proven in this
+ * project by drivers/NativeGeniSpi/GeniSpi.h (QUPv3 FIFO mode); that header and
+ * the Linux qcom-geni-se/qcom_geni_serial drivers were the reference for the
+ * offsets.  The luming UART window is 0x00A9C000 with size 0x4000 (SE7 of QUP
+ * wrapper 1), so every register used here stays below 0x4000.
+ */
+#ifndef _PEXPERT_ARM_QCOM_GENI_UART_H
+#define _PEXPERT_ARM_QCOM_GENI_UART_H
+
+/* GENI serial-engine registers (offset from the SE base; SE window is 0x4000). */
+#define QCOM_GENI_SE_GENI_STATUS                 0x40
+#define QCOM_GENI_SE_GENI_DMA_MODE_EN            0x258
+#define QCOM_GENI_SE_GENI_TX_FIFO                0x700   /* 0x700..0x77f, one 32-bit word per write */
+#define QCOM_GENI_SE_GENI_RX_FIFO                0x780   /* 0x780..0x7ff */
+#define QCOM_GENI_SE_GENI_TX_FIFO_STATUS         0x800
+#define QCOM_GENI_SE_GENI_RX_FIFO_STATUS         0x804
+#define QCOM_GENI_SE_GENI_TX_PACKING_CFG0        0x260
+#define QCOM_GENI_SE_GENI_TX_PACKING_CFG1        0x264
+#define QCOM_GENI_SE_GENI_HW_PARAM_0             0xe24
+
+/* GENI_STATUS */
+#define QCOM_GENI_STATUS_M_CMD_ACTIVE            (1u << 0)
+
+/* FIFO-mode selection: 0 = FIFO/PIO mode, 1 = DMA/GSI mode. */
+#define QCOM_GENI_DMA_MODE_ENABLED               (1u << 0)
+
+/*
+ * FIFO-status word-count fields, cross-checked against the stock luming
+ * msm_geni_serial.ko disassembly (agents/xnu-geni/work/geni-ko-evidence.txt):
+ * TX_FIFO_STATUS word count = bits 27:0 (vendor: and #0xfffffff), RX word
+ * count = bits 24:0 plus LAST/LAST_VALID bits 31/30:28 (vendor: and #0x1ffffff,
+ * ubfx #28,3, bit 31).  The backend derives "TX FIFO full" from the word count
+ * and the FIFO depth instead of relying on a vendor-uncertain full flag, so a
+ * gated or wedged SE reads as full and the bounded poll gives up instead of
+ * hanging the boot.
+ */
+#define QCOM_GENI_TX_FIFO_WC_MASK                0x0fffffffu
+#define QCOM_GENI_RX_FIFO_WC_MASK                0x01ffffffu
+
+/* GENI_HW_PARAM_0 TX-FIFO depth: 8 bits at bit 16 on QUPv3, 6 bits on older QUP. */
+#define QCOM_GENI_HW_PARAM0_TX_DEPTH_MASK_QUPV3  0x00ff0000u
+#define QCOM_GENI_HW_PARAM0_TX_DEPTH_MASK_QUPV2  0x003f0000u
+#define QCOM_GENI_HW_PARAM0_TX_DEPTH_SHIFT       16
+
+/* Plain MMIO reads are cheap; if the FIFO never drains, give up and drop output. */
+#define QCOM_GENI_TX_POLL_LIMIT                  1000000u
+
+/*
+ * TX packing config for one 8-bit character per 32-bit FIFO word, LSB first.
+ * Values produced by the same algorithm as this project's NativeGeniSpi
+ * config_packing() for geni_se_config_packing(se, bpw=8, pack_words=1,
+ * msb_to_lsb=false): one vector {start=0, direction=0, length=7, stop=1}.
+ * The vendor UART console port uses exactly that packing; a firmware tty setup
+ * can leave 4-characters-per-word packing instead.  Define
+ * QCOM_GENI_UART_PROGRAM_PACKING=0 to trust the bootloader configuration.
+ */
+#define QCOM_GENI_UART_TX_PACK_CFG0              0x0000000fu
+#define QCOM_GENI_UART_TX_PACK_CFG1              0x00000000u
+#ifndef QCOM_GENI_UART_PROGRAM_PACKING
+#define QCOM_GENI_UART_PROGRAM_PACKING           1
+#endif
+
+#endif /* _PEXPERT_ARM_QCOM_GENI_UART_H */
