diff --git a/GccUfsSm8735.h b/GccUfsSm8735.h
new file mode 100644
index 0000000000000000000000000000000000000000..234413b537a58f15f7b1e2a505e6db1897ee574e
--- /dev/null
+++ b/GccUfsSm8735.h
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// SM8735 (Qualcomm "gcc-tuna") GCC registers used by UFS. Transcribed as facts
+// from the public Linux gcc-tuna.c clock driver used as evidence in
+// REPORT-UFS-PLAN.md §6 (xiaomi-onyx-dev/android_kernel_xiaomi_sm8735,
+// lineage-23.2). No write is performed by NativeUfs; these offsets feed the
+// read-only stage-0 snapshot (and a future, separately reviewed power-up).
+//
+// Differences from the SM8550 table in GccUfs.h: 8 of the 9 UFS branch offsets
+// differ (AXI is the only identical one); the AGGR E branch (0x770f4) also
+// differs from SM8750 (0x770f0). GDSC and reset-BCR offsets are unchanged.
+#ifndef NATIVE_UFS_GCC_UFS_SM8735_H
+#define NATIVE_UFS_GCC_UFS_SM8735_H
+
+// GDSCs (physical offsets; the driver maps GCC_BASE + 0x77000 and GCC_BASE + 0x9e000):
+// gcc_ufs_phy_gdsc at 0x177004, gcc_ufs_mem_phy_gdsc at 0x19e000.
+#define GCC_UFS_PHY_GDSCR             0x77004
+#define GCC_UFS_MEM_PHY_GDSCR         0x9e000
+
+// UFS PHY branches (CBCR, halt_bit 0, enable bit 0; hwcg_bit 1 for AXI/AHB/UNIPRO/ICE/AUX/AGGRE).
+#define GCC_UFS_PHY_AXI_ENABLE        0x77018
+#define GCC_UFS_PHY_AHB_ENABLE        0x77028
+#define GCC_UFS_PHY_TX_SYMBOL0_ENABLE 0x7702c
+#define GCC_UFS_PHY_RX_SYMBOL0_ENABLE 0x77030
+#define GCC_UFS_PHY_UNIPRO_CORE_ENABLE 0x7706c
+#define GCC_UFS_PHY_ICE_CORE_ENABLE   0x7707c
+#define GCC_UFS_PHY_PHY_AUX_ENABLE    0x770bc
+#define GCC_UFS_PHY_RX_SYMBOL1_ENABLE 0x770d8
+// gcc_aggre_ufs_phy_axi_clk (bus_aggr_clk in the board DT), hwcg_bit 1.
+#define GCC_AGGRE_UFS_PHY_AXI_ENABLE  0x770f4
+
+// RCG2 command registers (source clocks; read-only in the stage-0 snapshot).
+#define GCC_UFS_PHY_AXI_CLK_SRC          0x77034
+#define GCC_UFS_PHY_ICE_CORE_CLK_SRC     0x7708c
+#define GCC_UFS_PHY_UNIPRO_CORE_CLK_SRC  0x770a4
+#define GCC_UFS_PHY_PHY_AUX_CLK_SRC      0x770c0
+
+// Reset: GCC_UFS_PHY_BCR at 0x77000, reset id 19 (0x13) in the board DT; not
+// deasserted by this driver yet.
+#define GCC_UFS_PHY_BCR               0x77000
+#define GCC_UFS_PHY_BCR_RESET_ID      19
+
+#endif /* NATIVE_UFS_GCC_UFS_SM8735_H */
